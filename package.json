{
  "name": "plain-pseudocode",
  "version": "0.1.4",
  "description": "Write pseudocode as plain indented text; render it as a centered, line-numbered text block.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test:unit": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "check:mobile": "node scripts/check-mobile-compat.mjs",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "test:e2e:fast": "OBSIDIAN_VERSIONS=latest/latest OBSIDIAN_E2E_TARGET=desktop wdio run ./wdio.conf.mts",
    "test:e2e:mobile": "OBSIDIAN_VERSIONS=latest/latest OBSIDIAN_E2E_TARGET=mobile wdio run ./wdio.conf.mts",
    "test:e2e:android": "wdio run ./wdio.mobile.conf.mts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pseudocode",
    "algorithm"
  ],
  "author": "Ding Zheng Yuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingzy53/obsidian-pseudocode.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.17",
    "@wdio/appium-service": "^9.33.1",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "appium": "^3.9.1",
    "appium-uiautomator2-driver": "^7.6.2",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "mocha": "^10.8.2",
    "obsidian": "1.14.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0"
  }
}
